{
  "name": "n8n-nodes-zellia",
  "version": "0.2.2",
  "description": "n8n nodes for Zellia: send messages and manage conversations, contacts and deals, and trigger workflows from Zellia events",
  "license": "MIT",
  "homepage": "https://github.com/propiter/n8n-nodes-zellia#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "zellia",
    "chatwoot",
    "whatsapp",
    "crm"
  ],
  "author": {
    "name": "Propiter",
    "email": "pro.pedro0413@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/propiter/n8n-nodes-zellia.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "n8n-node build && node --test test/*.test.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/ZelliaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Zellia/Zellia.node.js",
      "dist/nodes/ZelliaTrigger/ZelliaTrigger.node.js",
      "dist/nodes/ZelliaToolTrigger/ZelliaToolTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/propiter/n8n-nodes-zellia/issues"
  }
}
